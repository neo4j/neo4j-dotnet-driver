{
    "Backend": {
        "Address": "0.0.0.0",
        "Port": 9876
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console" ],
        "MinimumLevel": "Information",
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": {
                        "type": "Neo4j.Driver.TestKitBackend.Logging.TruncatingTextFormatter, Neo4j.Driver.TestKitBackend",
                        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
                        "maxLength": 2048
                    }
                }
            }
        ]
    }
}
