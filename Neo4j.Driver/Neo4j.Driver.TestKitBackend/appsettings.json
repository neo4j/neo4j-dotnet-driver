{
    "Backend": {
        "Address": "0.0.0.0",
        "Port": 9876
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Information"
            }
        },
        "Using": [ "Serilog.Sinks.Console" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": {
                        "type": "Neo4j.Driver.TestKitBackend.Logging.TruncatingTextFormatter, Neo4j.Driver.TestKitBackend",
                        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{SourceContextShort:l}{NewLine}{Exception}",
                        "maxLength": 8192
                    }
                }
            }
        ]
    }
}
