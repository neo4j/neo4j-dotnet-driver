{
    "Serilog": {
        "Using": [ "Serilog.Sinks.File" ],
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "/driver/artifacts/backend.log",
                    "formatter": {
                        "type": "Neo4j.Driver.TestKitBackend.Logging.TruncatingTextFormatter, Neo4j.Driver.TestKitBackend",
                        "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{SourceContextShort:l}{LoggingContext:l}{NewLine}{Exception}",
                        "maxLength": 8192
                    }
                }
            }
        ]
    }
}
